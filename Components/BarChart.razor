@using System.Globalization

<figure class="chart">
    <figcaption>
        <h3>@Title</h3>
        @if (!string.IsNullOrEmpty(Note))
        {
            <p class="chart-note">@Note</p>
        }
    </figcaption>

    <div class="plot">
        <div class="yaxis">
            @foreach (var t in Ticks())
            {
                <span class="ytick" style="bottom:@(Pct(t / AxisMax()))%">@Fmt(t)</span>
            }
        </div>

        <div class="grid">
            @foreach (var t in Ticks())
            {
                <span class="gridline" style="bottom:@(Pct(t / AxisMax()))%"></span>
            }

            <div class="bars">
                @for (var i = 0; i < Values.Length; i++)
                {
                    var v = Values[i];
                    var lbl = i < Labels.Length ? Labels[i] : "";
                    <div class="slot" tabindex="0" role="img"
                         aria-label="@lbl: @ValueText(v)">
                        <span class="tip"><strong>@ValueText(v)</strong><span>@lbl</span></span>
                        <span class="bar" style="height:@(Pct(v / AxisMax()))%"></span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="xaxis">
        <span>@XMin</span>
        @if (!string.IsNullOrEmpty(XMid))
        {
            <span>@XMid</span>
        }
        <span>@XMax</span>
    </div>
    @if (!string.IsNullOrEmpty(XTitle))
    {
        <p class="axis-title">@XTitle</p>
    }

    <details class="tableview">
        <summary>Table view</summary>
        <table>
            <thead>
                <tr><th scope="col">@ColX</th><th scope="col">@ColY</th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Values.Length; i++)
                {
                    <tr>
                        <td>@(i < Labels.Length ? Labels[i] : "")</td>
                        <td class="num">@ValueText(Values[i])</td>
                    </tr>
                }
            </tbody>
        </table>
    </details>
</figure>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Note { get; set; }
    [Parameter, EditorRequired] public double[] Values { get; set; } = [];
    [Parameter, EditorRequired] public string[] Labels { get; set; } = [];
    [Parameter] public string? Unit { get; set; }
    [Parameter] public string Format { get; set; } = "0.#";
    [Parameter] public double? Max { get; set; }
    [Parameter] public string XMin { get; set; } = "";
    [Parameter] public string? XMid { get; set; }
    [Parameter] public string XMax { get; set; } = "";
    [Parameter] public string? XTitle { get; set; }
    [Parameter] public string ColX { get; set; } = "Bucket";
    [Parameter] public string ColY { get; set; } = "Value";

    string Fmt(double v) => v.ToString(Format, CultureInfo.InvariantCulture);

    string ValueText(double v) => Fmt(v) + Unit;

    // Inline geometry must never pick up a comma decimal separator (fr-FR etc.).
    static string Pct(double frac) =>
        (Math.Clamp(frac, 0, 1) * 100).ToString("0.##", CultureInfo.InvariantCulture);

    double AxisMax()
    {
        if (Max is { } m) return m;
        var peak = Values.Length == 0 ? 1 : Values.Max();
        var step = NiceStep(peak / 4);
        return Math.Ceiling(peak / step) * step;
    }

    static double NiceStep(double raw)
    {
        if (raw <= 0) return 1;
        var mag = Math.Pow(10, Math.Floor(Math.Log10(raw)));
        var n = raw / mag;
        var f = n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10;
        return f * mag;
    }

    IEnumerable<double> Ticks()
    {
        var max = AxisMax();
        var step = NiceStep(max / 4);
        for (var t = 0.0; t <= max + 1e-9; t += step) yield return t;
    }
}
