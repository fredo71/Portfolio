<div class="project-card">
    <img src="@ImageUrl" alt="@Title" class="project-thumbnail" />
    <div class="project-info">
        <h3>@Title</h3>
        <p>@Description</p>
        <div class="project-tags">
            @foreach (var tag in Tags)
            {
                <span class="tag">@tag</span>
            }
        </div>
        @if (IsPrivate)
        {
            <span class="private-badge"><i class="bi bi-lock-fill"></i> Private</span>
        }
        else
        {
            <a href="@Link" target="_blank" class="btn-styled">@LinkLabel</a>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string ImageUrl { get; set; } = "";
    [Parameter] public string Link { get; set; } = "#";
    [Parameter] public string LinkLabel { get; set; } = "View";
    [Parameter] public List<string> Tags { get; set; } = new();
    [Parameter] public bool IsPrivate { get; set; } = false;
}
