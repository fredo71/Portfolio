<div class="project-card @(Featured ? "featured" : "")">
    @if (Featured)
    {
        <span class="featured-badge">Projet phare</span>
    }
    @if (!string.IsNullOrEmpty(VideoUrl))
    {
        <video class="project-thumbnail" src="@VideoUrl" poster="@ImageUrl"
               autoplay muted loop playsinline preload="metadata"></video>
    }
    else
    {
        <img src="@ImageUrl" alt="@Title" class="project-thumbnail" />
    }
    <div class="project-info">
        <h3>@Title</h3>
        <p>@Description</p>
        <div class="project-tags">
            @foreach (var tag in Tags)
            {
                <span class="tag">@tag</span>
            }
        </div>
        @if (IsPrivate)
        {
            <span class="private-badge"><i class="bi bi-lock-fill"></i> Private</span>
        }
        else
        {
            <a href="@Link" target="_blank" class="btn-styled @(Featured ? "btn-featured" : "")">
                @LinkLabel
                @if (Featured)
                {
                    <i class="bi bi-arrow-right"></i>
                }
            </a>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string ImageUrl { get; set; } = "";
    [Parameter] public string Link { get; set; } = "#";
    [Parameter] public string LinkLabel { get; set; } = "View";
    [Parameter] public List<string> Tags { get; set; } = new();
    [Parameter] public bool IsPrivate { get; set; } = false;
    [Parameter] public string VideoUrl { get; set; } = "";
    [Parameter] public bool Featured { get; set; } = false;
}
