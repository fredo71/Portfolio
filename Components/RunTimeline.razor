@using System.Globalization

<figure class="chart">
    <figcaption>
        <h3>@Title</h3>
        @if (!string.IsNullOrEmpty(Note))
        {
            <p class="chart-note">@Note</p>
        }
    </figcaption>

    <div class="plot">
        <div class="yaxis">
            @foreach (var t in Ticks)
            {
                <span class="ytick" style="bottom:@Pct(t / AxisMax)%">@N0(t)</span>
            }
        </div>

        <div class="canvas" role="img" aria-label="@Summary()">
            @* phase bands sit behind everything, so the plot never fights them *@
            @foreach (var p in Phases)
            {
                <span class="phase-band @(p.Highlight ? "phase-band--key" : "")"
                      style="left:@Pct(p.Start / Duration)%;width:@Pct(p.Length / Duration)%"></span>
            }

            @foreach (var t in Ticks)
            {
                <span class="gridline" style="bottom:@Pct(t / AxisMax)%"></span>
            }

            <span class="threshold" style="bottom:@Pct(30 / AxisMax)%">
                <span class="threshold-label">30 fps</span>
            </span>

            @* envelope: worst and best frame in each pixel column, so no spike can be sampled away *@
            <svg viewBox="0 0 1000 220" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path class="envelope" d="@EnvelopePath()" />
                <path class="line" d="@MeanPath()" vector-effect="non-scaling-stroke" />
            </svg>
        </div>
    </div>

    <div class="phase-row">
        @foreach (var p in Phases)
        {
            <div class="phase @(p.Highlight ? "phase--key" : "")" style="flex-grow:@Grow(p.Length)">
                <span class="phase-name">@p.Name</span>
                <span class="phase-time">@N1(p.Length) s</span>
            </div>
        }
    </div>

    <p class="axis-title">seconds since launch</p>

    <details class="tableview">
        <summary>Table view</summary>
        <table>
            <thead>
                <tr>
                    <th scope="col">Phase</th>
                    <th scope="col">Duration</th>
                    <th scope="col">Lowest</th>
                    <th scope="col">Typical</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Phases)
                {
                    var (lo, mean) = StatsFor(p);
                    <tr>
                        <td>@p.Name</td>
                        <td class="num">@N1(p.Length) s</td>
                        <td class="num">@N0(lo) fps</td>
                        <td class="num">@N0(mean) fps</td>
                    </tr>
                }
            </tbody>
        </table>
    </details>
</figure>

@code {
    public record Phase(string Name, double Start, double Length, bool Highlight = false);

    [Parameter] public string Title { get; set; } = "The whole run";
    [Parameter] public string? Note { get; set; }

    const double Duration = 60;      // seconds of capture
    const double AxisMax = 90;       // fps
    const int Columns = 220;         // one envelope pair per pixel column

    static readonly double[] Ticks = [0, 30, 60, 90];

    static readonly Phase[] Phases =
    [
        new("scene load", 0, 8.3),
        new("world fills in", 8.3, 4.0, Highlight: true),
        new("free flight", 12.3, 47.7),
    ];

    // PLACEHOLDER SHAPE. Deterministic stand-in for the real capture so the layout can be
    // judged before the data exists. Replace these three arrays with per-column min/max/mean
    // read from the run CSV; nothing else in this component needs to change.
    static readonly double[] Lo = new double[Columns];
    static readonly double[] Hi = new double[Columns];
    static readonly double[] Mid = new double[Columns];

    static RunTimeline()
    {
        var rng = new Random(7);
        for (var i = 0; i < Columns; i++)
        {
            var t = i / (double)(Columns - 1) * Duration;
            double lo, hi;

            if (t < 8.3)
            {
                // nothing is being drawn yet
                lo = 0.1; hi = 0.6;
            }
            else if (t < 12.3)
            {
                // the queue catching up: wide, ragged, dipping hard
                var k = (t - 8.3) / 4.0;                      // 0 -> 1 across the phase
                lo = 6 + 34 * k + rng.NextDouble() * 12;
                hi = 62 + 30 * (1 - k) + rng.NextDouble() * 10;
            }
            else
            {
                // settled: narrow band with the occasional single-frame dip
                lo = 54 + rng.NextDouble() * 6;
                hi = 68 + rng.NextDouble() * 7;
                if (rng.NextDouble() < 0.06) lo -= 8 + rng.NextDouble() * 6;
            }

            Lo[i] = Math.Clamp(lo, 0, AxisMax);
            Hi[i] = Math.Clamp(hi, 0, AxisMax);
            Mid[i] = (Lo[i] + Hi[i]) / 2;
        }
    }

    // Inline geometry must never pick up a comma decimal separator (fr-FR etc.).
    static string Pct(double frac) =>
        (Math.Clamp(frac, 0, 1) * 100).ToString("0.###", CultureInfo.InvariantCulture);

    static string N(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    static string N0(double v) => v.ToString("0", CultureInfo.InvariantCulture);
    static string N1(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
    static string Grow(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    static double X(int i) => i / (double)(Columns - 1) * 1000;
    static double Y(double fps) => 220 - Math.Clamp(fps / AxisMax, 0, 1) * 220;

    // Upper edge left-to-right, lower edge back again: the band between best and worst.
    static string EnvelopePath()
    {
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < Columns; i++)
            sb.Append(i == 0 ? 'M' : 'L').Append(N(X(i))).Append(' ').Append(N(Y(Hi[i]))).Append(' ');
        for (var i = Columns - 1; i >= 0; i--)
            sb.Append('L').Append(N(X(i))).Append(' ').Append(N(Y(Lo[i]))).Append(' ');
        return sb.Append('Z').ToString();
    }

    static string MeanPath()
    {
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < Columns; i++)
            sb.Append(i == 0 ? 'M' : 'L').Append(N(X(i))).Append(' ').Append(N(Y(Mid[i]))).Append(' ');
        return sb.ToString().TrimEnd();
    }

    static (double Lowest, double Typical) StatsFor(Phase p)
    {
        double lowest = AxisMax, sum = 0; var n = 0;
        for (var i = 0; i < Columns; i++)
        {
            var t = i / (double)(Columns - 1) * Duration;
            if (t < p.Start || t > p.Start + p.Length) continue;
            lowest = Math.Min(lowest, Lo[i]);
            sum += Mid[i];
            n++;
        }
        return n == 0 ? (0, 0) : (lowest, sum / n);
    }

    string Summary()
    {
        var parts = Phases.Select(p =>
        {
            var (lo, mean) = StatsFor(p);
            return $"{p.Name}, {N1(p.Length)} seconds, typically {N0(mean)} fps, lowest {N0(lo)} fps";
        });
        return "Frame rate across the whole 60-second run. " + string.Join(". ", parts) + ".";
    }
}
