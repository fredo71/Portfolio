@code {
    [Parameter] public int Level { get; set; }
    [Parameter] public int Max { get; set; } = 5;
}

<div class="skill-dots" >
    @for (int i = 1; i <= Max; i++)
    {
        <span class="dot @(i <= Level ? "filled" : "")"></span>
    }
</div>

<Style>
    /* Sizes follow the --cv-dot* variables of whatever context the dots sit in,
       so the CV can shrink them for narrow screens and for A4. */
    .skill-dots {
        display: flex;
        gap: var(--cv-dot-gap, 8px);
        margin-left: var(--cv-dot-margin, 20px);
        align-items: center;

    }

    .dot {
        width: var(--cv-dot, 20px);
        height: var(--cv-dot, 20px);
        flex: none;
        border-radius: 50%;
        background-color: #b4b4b4;

    }

    .dot.filled {
        background-color: #4f81bd;
    }
</Style>
