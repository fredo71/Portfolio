@* Bootstrap Icons (MIT), the same 1.11.0 set index.html loads as a font, drawn
   as inline SVG instead. The font draws each icon as a private-use character,
   and those characters land in the PDF's text layer — in the middle of the
   contact line an ATS reads the phone number and address from. A path is
   drawn, not typed, so it adds nothing to the text. *@
<svg class="svg-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    @foreach (var path in Icons[Name])
    {
        <path d="@path.D" fill-rule="@(path.EvenOdd ? "evenodd" : null)" />
    }
</svg>

