@page "/AboutMe"

<PageTitle>Frédéric Larue — À propos</PageTitle>

<div class="about-page">

    <section class="section">
        <div class="hero">
            <h1>Frédéric Larue</h1>
            <p class="hero-subtitle">Développeur C# .NET</p>
            <p class="hero-intro">
                Développeur passionné basé à Troyes, à la recherche d'un poste en ingénierie logicielle.<br>
                Formé en DevOps et en développement full stack.
            </p>
            <div class="hero-actions">
                <a href="https://github.com/fredo71" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="svg-gradiant maximize-icon">
                    <i class="bi bi-github" aria-hidden="true"></i>
                </a>
                <a href="#Project" class="btn-styled">
                    Voir le projet phare
                </a>
                <a href="/Cv" class="btn-styled">
                    Voir le CV
                </a>
                <a href="/cv-frederic-larue.pdf" download class="btn-styled">
                    Télécharger le CV
                </a>
            </div>
        </div>
    </section>

    <section class="section" id="About">
        <div class="section-head">
            <h2>Ce que je cherche</h2>
            <p class="section-subtitle">Le poste que je vise, et ce que j'apporte.</p>
        </div>

        <div class="bio panel">
            <img src="images/head shot.jpg" alt="Portrait de Frédéric Larue" class="bio-photo" />
            <div class="bio-text">
                <p class="bio-lead">
                    Un poste de développeur C#, en CDI, disponible immédiatement, mobile dans toute la France
                    métropolitaine.
                </p>
                <p>
                    Je suis à l'aise avec le logiciel qui doit tenir dans un budget de temps, de mémoire ou de calcul.
                    Je l'ai appris sur mon moteur de terrain, en profilant plutôt qu'en devinant. C'était du C#, et
                    c'est là que j'ai vu où il coûte cher quand on ne le surveille pas.
                </p>
            </div>
        </div>
    </section>

    <section class="section" id="Project">
        <div class="section-head">
            <h2>Projet phare</h2>
            <p class="section-subtitle">Le projet qui me représente le mieux aujourd'hui.</p>
        </div>

        <div class="project-showcase">
            <ProjectCard
                Title="Jeu Unity — Moteur de terrain hexagonal"
                Description="Un jeu développé avec Unity, intégrant des shaders personnalisés, de la génération de maillage et du multithreading."
                ImageUrl="video/hexmap-flythrough.jpg"
                VideoUrl="video/hexmap-flythrough.mp4"
                Link="/Game"
                LinkLabel="Voir la page complète"
                Featured="true"
                Tags='new List<string> { "Unity", "C#", "HLSL" , "Job System"}' />
        </div>
    </section>

    <section class="section" id="Experience">
        <div class="section-head">
            <h2>Expérience</h2>
            <p class="section-subtitle">Ce que j'ai construit en conditions réelles.</p>
        </div>

        <div class="experience-card panel">
            <div class="experience-header">
                <h3 class="experience-title">Développeur logiciel — Davey Bickford Enaex</h3>
                <span class="experience-date">2023 – 2025</span>
            </div>
            <p class="experience-meta">Alternance de master · Héry, Bourgogne-Franche-Comté</p>
            <p class="experience-description">
                Développement d'un outil interne de gestion du matériel industriel, avec intégration de
                tests automatisés. Réalisation en autonomie, au contact direct des clients internes et en
                coordination avec les équipes cybersécurité et infrastructure.
            </p>
            <div class="experience-tags">
                <span class="pill">Python</span>
                <span class="pill">Django</span>
                <span class="pill">PostgreSQL</span>
                <span class="pill">Tests automatisés</span>
                <span class="pill">Docker</span>
            </div>
        </div>
