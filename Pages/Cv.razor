                <p class="rail-meta">Lycée Chrestien de Troyes</p>
            </div>
        </section>

        <section>
            <h2>Langues</h2>
            <p class="rail-line"><strong>Anglais</strong> : TOEIC C1, utilisé en entreprise</p>
            <p class="rail-line"><strong>Allemand</strong> : courant</p>
        </section>

        <section>
            <h2>Atouts</h2>
            <p class="rail-line">Autonomie · Rigueur · Esprit analytique · Logique</p>
        </section>

        <section>
            <h2>Centres d'intérêt</h2>
            <p class="rail-line">Jeux-vidéo de stratégie · Histoire · Écriture · Actualité</p>
        </section>

    </aside>
</div>
</div>
